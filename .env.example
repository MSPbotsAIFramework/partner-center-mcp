# Optional overrides — partner-center-mcp has no required env vars.
# Authentication is per-request via one request header, since this server
# never performs the Partner Center App+User OAuth exchange itself and never
# persists credentials:
#   X-PartnerCenter-Token — a bearer access token already issued for
#     resource https://api.partnercenter.microsoft.com via the partner's own
#     Entra ID app (App+User authentication). Obtained and refreshed outside
#     this service; forwarded here as-is.
# This server forwards the token as "Authorization: Bearer <token>" on every
# upstream call.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# Overridable in case a sovereign-cloud Partner Center endpoint is ever
# needed; defaults to the public commercial endpoint.
PARTNER_CENTER_BASE_URL=https://api.partnercenter.microsoft.com/v1
